# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment and secrets
.env
.env.*
!.env.example

# Large model weights (nano model is automatically downloaded or kept)
yolov8l.pt
*.pt.cache

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs and local databases
*.log
*.sqlite
*.sqlite3
*.db
*.db-journal

# Runtime generated alert media & evidence
static/alerts/*.jpg
static/alerts/*.png
static/alerts/evidence/*.enc
static/alerts/evidence/*.json

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
